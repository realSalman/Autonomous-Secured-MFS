# ── Required ──
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── LLM Provider (choose one) ──
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Ojuri Fraud Detection (optional) ──
OJURI_ENABLED=false
OJURI_API_URL=
OJURI_API_KEY=
OJURI_WEBHOOK_SECRET=

# ── Vercel Deployment ──
# Set SEED_SECRET to protect the /api/seed endpoint
SEED_SECRET=
